# Copy to .env and fill in. NEVER commit .env.
# ---- Required for any mode ----
# MongoDB connection string. Local docker: mongodb://localhost:27017/parcelpilot
# Atlas free M0: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/parcelpilot
MONGODB_URI=mongodb://localhost:27017/parcelpilot
# Secret for signing JWTs (min 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# ---- Profiles: demo (default) | prod ----
# demo  : mock providers, fixed OTP 123456, /api/dev/* endpoints enabled
# prod  : real providers when keys given, dev endpoints off
SPRING_PROFILES_ACTIVE=demo

# ---- Email ingestion (IMAP). Needed only for real forwarded-email flow ----
# Gmail address of the shared demo inbox
MAIL_USER=
# Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
MAIL_APP_PASSWORD=
# The forwarding address shown to users in Setup (defaults to MAIL_USER)
MAIL_FORWARD_TO=

# ---- Optional: real tracking providers (both work without these; mock is default) ----
# Ship24 free tier: 10 shipments/month, key issued on signup. https://ship24.co
SHIP24_API_KEY=
# 17TRACK: new accounts get a one-time 200 free numbers. https://res.17track.net
TRACK17_API_KEY=

# ---- Optional: LLM rephrasing of risk messages (never decides risk) ----
ANTHROPIC_API_KEY=
